{#- jinja2: lstrip_blocks: true, trim_blocks: true -#}
# {{ ansible_managed }}

http {
{% for format_name, format_lines in nginx_httpd_log_format.items() %}
    log_format  {{ format_name }}  '{{ format_lines[0] }}'
{% for line in format_lines[1:] %}
                      '{{ line }}'
{% endfor %}                      ;
{% endfor %}

    access_log  {{ nginx_httpd_access_log }}  {{ nginx_httpd_log_format.keys() | first }};
    error_log   {{ nginx_httpd_error_log }};

    sendfile            {{ nginx_service_sendfile }};
    tcp_nopush          {{ nginx_service_tcp_nopush }};
    tcp_nodelay         {{ nginx_service_tcp_nodelay }};
    keepalive_timeout   {{ nginx_service_keepalive_timeout }};
    types_hash_max_size {{ nginx_service_types_hash_max_size }};
    include             {{ nginx_service_include_mime_type }};
    default_type        {{ nginx_service_default_type }};
    server_tokens       {{ nginx_server_tokens | default('off') }};

{% if nginx_rate_limit_zones | default([]) | length > 0 %}
    # Rate limiting zones
{% for zone in nginx_rate_limit_zones %}
    limit_req_zone {{ zone.key }} zone={{ zone.name }}:{{ zone.size | default('10m') }} rate={{ zone.rate }};
{% endfor %}
{% endif %}

{% if nginx_proxy_cache.enabled | default(false) | bool %}
    proxy_cache_path {{ nginx_proxy_cache.path }} levels={{ nginx_proxy_cache.levels }} keys_zone={{ nginx_proxy_cache.keys_zone }}:{{ nginx_proxy_cache.keys_zone_size | default('10m') }} inactive={{ nginx_proxy_cache.inactive }} max_size={{ nginx_proxy_cache.max_size }};
{% endif %}

{% if nginx_gzip_enabled | default(true) | bool %}
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
{% endif %}

    # Default http server configurations
    include {{ nginx_service_config_path }}/conf.d/*.conf;

{% if nginx_vhost_servers %}
    # Virtual Host configurations
    include {{ nginx_service_config_path }}/vhost.d/*.conf;
{% endif %}

{% if nginx_http_loadbalancers %}
    # HTTP Load Balancer configurations
    include {{ nginx_service_config_path }}/http.d/*.conf;
{% endif %}

{% if nginx_static_file_servers %}
    # Include Static file server configurations
    include {{ nginx_service_config_path }}/static.conf;
{% endif %}
}
